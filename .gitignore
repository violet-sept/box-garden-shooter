# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-electron/
release/
*.tsbuildinfo

# Local scratch
# `.tmp-*` without a trailing slash so scratch *files* are covered too, not just
# directories: the acceptance reports, the Electron profile directory and
# throwaway diagnostic scripts all live under this prefix. (The 158 MB offline
# Electron zip cache used to live here as well; it was deleted once the
# `--config.electronDist=node_modules/electron/dist` route made it redundant.)
.tmp-*
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Game assets: source masters are large and licensed per-project.
# Optimised derivatives under public/assets/ ARE committed; raw imports are not.
assets-source/
*.blend
*.psd
*.fbx

# Local model scratch (MMD `.pmx` etc). Kept out of the repository on purpose —
# not only because they are large, but because the third-party models dropped here
# carry their own terms (`请勿二次配布` / `请勿用于商业用途`, copyright miHoYo), so
# republishing them in a public repo is not something this project can do. Convert to
# `.glb` and use only assets you have the right to distribute.
模型/
*.pmx
*.pmd
*.vmd
