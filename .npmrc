# Test-runner preload, applied to every npm script.
#
# `tests/preload.mjs` does two things the sandboxed Windows runner needs, and
# neither is expressible in a config file:
#
#   1. It neutralises Vite's `net use` network-drive probe, which spawns a child
#      process that locked-down environments deny (the failure surfaces as
#      "failed to load config", which hides the real cause).
#   2. It registers an ESM resolve hook so Node infers `.ts` on the project's
#      extensionless bundler-style imports.
#
# npm turns `node-options` into `NODE_OPTIONS` for the script it runs. Using
# `.npmrc` rather than `cross-env` means `npm test` works on Windows without
# adding a dependency, and without a platform-specific shell syntax in
# `package.json`. The path resolves against the directory npm runs in, which is
# the project root for every script here.
node-options=--import=./tests/preload.mjs
